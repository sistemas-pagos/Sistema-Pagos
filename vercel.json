{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD .",
  "git": {
    "deploymentEnabled": {
      "portfolio-data": false,
      "rpi/**": false,
      "mundial/**": false,
      "monorepo/**": false
    }
  }
}
