APP_MODE=demo
APP_BASE_URL=
MAX_RECEIPT_BYTES=8388608
PENDING_CONTEXT_MINUTES=30
EXPECTED_PAYMENT_AMOUNT=150

ADMIN_ACCESS_KEY=
AUTH_SESSION_SECRET=

GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

EXPECTED_BENEFICIARY=
EXPECTED_ACCOUNT_LAST4=

# Turso es la fuente de verdad (docs/PLAN.md, seccion 1). El webhook escribe
# aqui el registro de mensajes; el worker de Actions lee la cola.
PAGOS_TURSO_URL=
PAGOS_TURSO_TOKEN=

# repository_dispatch hacia GitHub Actions. Si faltan, el webhook responde 200
# igual y el cron de procesar-comprobantes levanta la cola unos minutos despues.
PAGOS_GITHUB_REPO=
PAGOS_DISPATCH_TOKEN=
